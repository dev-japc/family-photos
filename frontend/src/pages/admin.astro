---
// src/pages/admin.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '@components/footer.astro'
import PhotoManager from '@components/admin/PhotoManager.astro';
import WhiteListManager from '@components/admin/WhiteListManager.astro';
// @ts-ignore
import { jwtDecode } from 'jwt-decode';

const token = Astro.cookies.get("auth_token")?.value;

// if there's no token, redirect to login page
if (!token) {
  return Astro.redirect("/login");
}

// Decoding the token to check if the user is admin
try {
  const decoded: any = jwtDecode(token);
  const isAdmin = decoded.is_admin === true || decoded.role === 'admin';
  if (!isAdmin) {
    return Astro.redirect("/");
  }
} catch (error) {
  return Astro.redirect("/logout");
}

const publicBackendUrl = import.meta.env.PUBLIC_BACKEND_URL;
---

<BaseLayout title="Panel de Administración">
  <nav class="w-full bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between shadow-sm">
    <div class="flex items-center gap-2">
      <span class="text-2xl">⚙️</span>
      <span class="text-xl font-bold text-slate-800 tracking-tight">Panel de Control</span>
    </div>
    <a href="/" class="text-sm font-medium text-blue-600 hover:underline" aria-label="back-to-album">
      Volver al Álbum
    </a>
  </nav>

  <div class="max-w-xl w-full mx-auto px-4 py-8 grow">
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-center text-slate-800">Lista Blanca de Acceso</h2>
      <p class="text-slate-500 text-center text-sm mt-1 p-3">Sólo las personas cuyas cédulas estén aquí registradas podrán crearse una cuenta en el sistema y ver las fotos.</p>
    </div>
    <WhiteListManager publicBackendUrl={publicBackendUrl} token={token} />
    <div class="mt-12 mb-8">
    <PhotoManager publicBackendUrl={publicBackendUrl} token={token} />

      
    </div>

    
  </div>
  <Footer />
</BaseLayout>
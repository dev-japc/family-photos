---
//src/components/admin/PhotoManager.astro
import { Image } from 'astro:assets'

interface Props {
  publicBackendUrl: string;
  token: string;
}

const { publicBackendUrl, token } = Astro.props;
---

<div class="space-y-6 h-fit">

  <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
    <h3 class="font-bold text-slate-800 mb-4">Crear Nuevo Subálbum</h3>
    
    <form id="create-album-form" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Nombre del Álbum</label>
        <input type="text" name="name" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all text-sm text-slate-800" placeholder="Ej. Vacaciones 2026, Navidad" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Descripción (Opcional)</label>
        <textarea name="description" rows="2" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all text-sm text-slate-800 resize-none" placeholder="Breve reseña del momento..."></textarea>
      </div>

      <button type="submit" id="album-btn" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 rounded-xl text-sm transition-colors shadow-md shadow-emerald-600/10 flex items-center justify-center gap-2">
        <span>📁</span> Crear Álbum
      </button>
    </form>
  </div>

  <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
    <h3 class="font-bold text-slate-800 mb-4">Subir Recuerdo Familiar</h3>
    
    <form id="upload-photo-form" class="space-y-4" enctype="multipart/form-data">
      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Título del Momento</label>
        <input type="text" name="title" required class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all text-sm text-slate-800" placeholder="Ej. Cumpleaños del Abuelo" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Asignar a Subálbum</label>
        <select id="photo-album-select" name="album_id" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all text-sm text-slate-800 bg-white">
          <option value="">Ninguno (Colección General)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Descripción (Opcional)</label>
        <textarea name="description" rows="2" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all text-sm text-slate-800 resize-none" placeholder="¿Qué pasó este día?"></textarea>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Seleccionar Imagen</label>
        <input type="file" name="image" id="photo-file-input" accept="image/png, image/jpeg, image/jpg, image/webp" required class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer" />
        <p class="text-[10px] text-slate-400 mt-1">Máximo 5MB (JPG, PNG, WEBP)</p>
      </div>

      <button type="submit" id="upload-btn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2.5 rounded-xl text-sm transition-colors shadow-md shadow-blue-600/10 flex items-center justify-center gap-2">
        <span>📤</span> Subir al Álbum
      </button>
    </form>
  </div>

  <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 mt-6">
    <h3 class="font-bold text-slate-800 text-center mb-4">Gestión del Álbum (Fotos)</h3>
    <div id="admin-photos-container" class="grid grid-cols-2 sm:grid-cols-3 gap-4">
    </div>
  </div>
</div>

<script define:vars={{ publicBackendUrl, token }} is:inline>
    const albumSelect = document.getElementById('photo-album-select');
    const createAlbumForm = document.getElementById('create-album-form');
    const albumBtn = document.getElementById('album-btn');
    const uploadForm = document.getElementById('upload-photo-form');
    const uploadBtn = document.getElementById('upload-btn');
    const photosContainer = document.getElementById('admin-photos-container');

    // 1. CARGAR ÁLBUMES EN EL SELECTOR
    async function fetchAlbumsForSelect() {
        try {
            const response = await fetch(`${publicBackendUrl}/api/albums`, {
                method: 'GET',
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const albums = await response.json();
            
            albumSelect.innerHTML = '<option value="">Ninguno (Colección General)</option>';
            
            albums.forEach(album => {
                const option = document.createElement('option');
                option.value = album.id;
                option.textContent = album.name;
                albumSelect.appendChild(option);
            });
        } catch (error) {
            console.error("Error al cargar los subálbumes:", error);
        }
    }

    // 2. ENVIAR NUEVO ÁLBUM
    createAlbumForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const originalBtnText = albumBtn.innerHTML;
        albumBtn.disabled = true;
        albumBtn.innerHTML = `<span>⏳</span> Creando...`;

        const formData = new FormData(createAlbumForm);
        const data = Object.fromEntries(formData);

        try {
            const response = await fetch(`${publicBackendUrl}/api/albums`, {
                method: 'POST',
                headers: { 
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });

            const result = await response.json();
            if (!response.ok) throw new Error(result.error || 'No se pudo crear el álbum');

            alert('¡Subálbum creado con éxito! 📁🎉');
            createAlbumForm.reset();
            fetchAlbumsForSelect(); // Sincroniza el menú desplegable al instante
        } catch (error) {
            alert(`⚠️ Error: ${error.message}`);
        } finally {
            albumBtn.disabled = false;
            albumBtn.innerHTML = originalBtnText;
        }
    });

    // 3. UPLOAD PHOTOS
    uploadForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const originalBtnText = uploadBtn.innerHTML;
        uploadBtn.disabled = true;
        uploadBtn.innerHTML = `<span>⏳</span> Subiendo archivo...`;

        const formData = new FormData(uploadForm);

        try {
            const response = await fetch(`${publicBackendUrl}/api/photos/upload`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}` 
                },
                body: formData
            });

            const result = await response.json();

            if (!response.ok) {
                throw new Error(result.error || 'Error desconocido al subir la imagen');
            }

            alert('¡Momento familiar guardado con éxito! 🎉');
            uploadForm.reset();
            fetchAdminPhotos(); // Refrescar la galería de administración

        } catch (error) {
            alert(`⚠️ Error: ${error.message}`);
        } finally {
            uploadBtn.disabled = false;
            uploadBtn.innerHTML = originalBtnText;
        }
    });

    // 4. FETCH ADMIN PHOTOS
    async function fetchAdminPhotos() {
        try {
            const response = await fetch(`${publicBackendUrl}/api/photos`, {
                method: 'GET',
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const data = await response.json();
            
            const photosList = data.photos || [];

            if (photosList.length === 0) {
                photosContainer.innerHTML = `<p class="col-span-full text-center text-xs text-slate-400 py-4">No hay fotos en el álbum.</p>`;
                return;
            }

            photosContainer.innerHTML = photosList.map(photo => `
                <div class="relative group rounded-xl overflow-hidden border border-slate-100 aspect-square bg-slate-50">
                <Image
                    src="${publicBackendUrl}${photo.url}"
                    class="w-full h-full object-cover"
                    loading="lazy"
                    alt="${photo.title || 'Foto familiar'}"
                />
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                    <button 
                    data-photo-id="${photo.id}" 
                    class="delete-photo-btn bg-red-600 hover:bg-red-700 text-white text-xs font-semibold px-2.5 py-1.5 rounded-lg transition-transform transform hover:scale-105"
                    >
                    🗑️ Eliminar
                    </button>
                </div>
                </div>
            `).join('');

            // Enganchar clicks para borrar foto
            document.querySelectorAll('.delete-photo-btn').forEach(btn => {
                btn.addEventListener('click', () => deletePhoto(btn.dataset.photoId));
            });

        } catch (error) {
            console.error("Error cargando fotos en admin:", error);
        }
    }

    // 5. DELETE PHOTO
    async function deletePhoto(id) {
        if (!confirm('¿Estás seguro de que deseas eliminar permanentemente esta foto del álbum?')) return;

        try {
            const response = await fetch(`${publicBackendUrl}/api/photos/${id}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${token}` }
            });

            const result = await response.json();
            if (!response.ok) throw new Error(result.error || 'No se pudo eliminar');

            alert('Foto eliminada correctamente 🎉');
            fetchAdminPhotos(); 
        } catch (error) {
            alert(`⚠️ Error: ${error.message}`);
        }
    }

    // Inicializar flujos de datos al cargar el componente
    fetchAlbumsForSelect();
    fetchAdminPhotos();
</script>